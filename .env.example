# ---- Alert delivery: ntfy | twilio | pushover | telegram | email | print
# Default is ntfy: free, no signup. Install the "ntfy" app (or open
# https://ntfy.sh/<your-topic> in a browser) and subscribe to the topic below.
# Use a long, hard-to-guess topic so nobody else can read your alerts.
NOTIFY_METHOD=ntfy
NTFY_TOPIC=stockradar-change-me-to-something-random

# ---- Data source ----
# By default the tool uses the ApeWisdom public API (NO keys, works from any IP).
# APEWISDOM_FILTER picks the feed: all-stocks | wallstreetbets | stocks | ...
APEWISDOM_FILTER=all-stocks

# Reddit (OPTIONAL): set these to use Reddit's official API instead of ApeWisdom
# (adds per-post sentiment + your exact subs). Register a "script" app at
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-radar/1.0 (personal daily digest)
SUBREDDITS=wallstreetbets,stockstobuytoday,Shortsqueeze

# ---- Only needed if you change NOTIFY_METHOD above ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
ALERT_TO=+1XXXXXXXXXX
PUSHOVER_TOKEN=
PUSHOVER_USER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# ---- Filtering / tuning ----
# Keep only names tradeable on Webull (US major exchanges); drops OTC/pink junk.
EXCHANGE_FILTER=1
# Set to 1 to also allow Toronto/TSX-listed names.
INCLUDE_CANADIAN=0
TOP_N=5
MAX_VALIDATE=30
